rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function isUser() { return request.auth != null; }

    match /settings/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /shifts/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /treatments/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /finance/{docId} { allow read, write: if isAdmin(); }
    
    match /users/{userId} {
      allow read, write: if isAdmin() || (isUser() && request.auth.uid == userId);
    }
    match /waitlist/{docId} {
      allow create: if isUser();
      allow read, update, delete: if isAdmin();
    }
    match /appointments/{docId} {
      allow read: if isAdmin() || (isUser() && resource.data.clientPhone == request.auth.uid);
      allow create: if isUser();
      allow update, delete: if isAdmin() || (isUser() && resource.data.clientPhone == request.auth.uid);
    }
    match /busy_slots/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /otps/{docId} { allow read, write: if false; }
    match /notifications/{docId} {
      allow create: if isUser() || isAdmin();
      allow read, update, delete: if isAdmin();
    }
  }
}